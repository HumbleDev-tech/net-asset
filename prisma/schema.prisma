// NetAsset - ITAM & HelpDesk Schema
// Sistema de Gestión de Activos TI y Mesa de Ayuda

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Ubicaciones (Departamentos / Áreas) ─────────────────────────
model Ubicacion {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique // Ej: "Maternidad", "Finanzas", "HODOM"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  usuarios  Usuario[]
  equipos   Equipo[]
}

// ─── Usuarios (Personal del hospital) ────────────────────────────
model Usuario {
  id          Int       @id @default(autoincrement())
  rut         String    @unique
  nombre      String
  correo      String?
  cargo       String?
  ubicacionId Int
  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  equipos     Equipo[]
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Equipos (PCs, Impresoras, etc.) ─────────────────────────────
model Equipo {
  id          Int       @id @default(autoincrement())
  tipo        TipoEquipo
  marca       String?   // Ej: "HP", "Lenovo", "Brother"
  modelo      String?   // Ej: "ProDesk 400 G7", "MFC-L2710DW"
  numeroSerie String?   @unique
  ip          String?   // Ej: "10.4.46.101"
  hostname    String?
  estado      EstadoEquipo @default(ACTIVO)
  notas       String?
  ubicacionId Int
  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id])
  usuarioId   Int?      // Las impresoras pueden no tener usuario
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
  insumos     EquipoInsumo[]
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Insumos (Tóners, Tintas, etc.) ─────────────────────────────
model Insumo {
  id          Int       @id @default(autoincrement())
  modelo      String    @unique // Ej: "TN-1060", "W9004MC"
  tipo        TipoInsumo
  marca       String?   // Ej: "HP", "Brother"
  stockActual Int       @default(0)
  stockMinimo Int       @default(2) // Alerta cuando llega a este nivel
  equipos     EquipoInsumo[]
  movimientos MovimientoInsumo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Relación Equipo-Insumo (qué insumo usa cada impresora) ─────
model EquipoInsumo {
  id        Int     @id @default(autoincrement())
  equipoId  Int
  equipo    Equipo  @relation(fields: [equipoId], references: [id])
  insumoId  Int
  insumo    Insumo  @relation(fields: [insumoId], references: [id])

  @@unique([equipoId, insumoId])
}

// ─── Movimientos de Insumos (Historial) ──────────────────────────
model MovimientoInsumo {
  id        Int              @id @default(autoincrement())
  insumoId  Int
  insumo    Insumo           @relation(fields: [insumoId], references: [id])
  tipo      TipoMovimiento
  cantidad  Int
  nota      String?
  createdAt DateTime         @default(now())
}

// ─── Tickets de Soporte (HelpDesk) ──────────────────────────────
model Ticket {
  id          Int           @id @default(autoincrement())
  titulo      String
  descripcion String?
  prioridad   Prioridad     @default(MEDIA)
  estado      EstadoTicket  @default(ABIERTO)
  usuarioId   Int
  usuario     Usuario       @relation(fields: [usuarioId], references: [id])
  equipoId    Int?
  equipo      Equipo?       @relation(fields: [equipoId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  closedAt    DateTime?
}

// ─── Enums ───────────────────────────────────────────────────────
enum TipoEquipo {
  PC
  NOTEBOOK
  IMPRESORA
  MONITOR
  TELEFONO
  OTRO
}

enum EstadoEquipo {
  ACTIVO
  EN_REPARACION
  DADO_DE_BAJA
  EN_BODEGA
}

enum TipoInsumo {
  TONER
  TINTA
  DRUM
  OTRO
}

enum TipoMovimiento {
  ENTRADA    // Compra / Recepción
  SALIDA     // Instalación en equipo
  AJUSTE     // Corrección de inventario
}

enum EstadoTicket {
  ABIERTO
  EN_PROGRESO
  RESUELTO
  CERRADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}
